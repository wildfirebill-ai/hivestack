# hivestack environment template — copy to .env (git-ignored) and edit.

# ---- auth -------------------------------------------------------------------
HIVESTACK_ADMIN_USER=admin
HIVESTACK_ADMIN_PASSWORD=changeme   # REQUIRED — set a strong password

# ---- local dirs (dev only; Docker/Unraid use /config /data /models volumes) --
# HIVESTACK_CONFIG_DIR=./runtime/config
# HIVESTACK_DATA_DIR=./runtime/data
# HIVESTACK_MODELS_DIR=./runtime/models

# ---- cloud providers (OPT-IN — leave empty + provider disabled = fully offline)
# Keys are read only after you enable the provider in Settings AND turn offline mode off.
#HIVESTACK_OPENAI_KEY=sk-...
#HIVESTACK_ANTHROPIC_KEY=sk-ant-...
#HIVESTACK_GEMINI_KEY=AIza...